:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #edf2ff;
  background: #081120;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 100%;
  background: #081120;
}

body {
  min-height: 100vh;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
  width: 100%;
  background: linear-gradient(135deg, #081120 0%, #101b2d 100%);
}

.sidebar {
  width: 320px;
  background: rgba(12, 18, 31, 0.9);
  border-right: 1px solid rgba(148, 163, 184, 0.2);
  padding: 24px 18px;
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
}

.logo {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #38bdf8, #8b5cf6);
  font-weight: 700;
}

.brand-block h1 {
  margin: 0;
  font-size: 1.5rem;
}

.login-box {
  display: flex;
  gap: 8px;
  margin-bottom: 18px;
}

.login-box input,
.composer input {
  flex: 1;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.7);
  color: #edf2ff;
  padding: 10px 12px;
}

.login-box button,
.composer button,
.primary,
.secondary {
  border: none;
  border-radius: 10px;
  padding: 10px 14px;
  font-weight: 600;
}

.login-box button,
.primary {
  background: linear-gradient(135deg, #3b82f6, #8b5cf6);
  color: white;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.contact-item {
  width: 100%;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid transparent;
  color: #edf2ff;
  border-radius: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  text-align: left;
}

.contact-item.active {
  border-color: rgba(96, 165, 250, 0.8);
  background: rgba(30, 41, 59, 0.92);
}

.avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #14b8a6, #3b82f6);
  font-weight: 700;
}

.contact-main {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.contact-main small {
  color: #94a3b8;
}

.chat-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 28px 18px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.2);
}

.chat-header h2 {
  margin: 0;
}

.chat-header span,
.call-meta {
  color: #94a3b8;
}

.video-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(180px, 1fr));
  gap: 14px;
  padding: 18px 28px;
}

.video-panel video {
  width: 100%;
  min-height: 220px;
  border-radius: 18px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  object-fit: cover;
}

.call-actions {
  display: flex;
  gap: 12px;
  padding: 0 28px 16px;
}

.secondary {
  background: rgba(148, 163, 184, 0.14);
  color: #edf2ff;
}

.message-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 28px 18px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.message {
  max-width: 70%;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 16px;
  padding: 12px 14px;
}

.message.self {
  align-self: flex-end;
  background: rgba(59, 130, 246, 0.22);
}

.message strong {
  display: block;
  margin-bottom: 6px;
}

.message p {
  margin: 0 0 6px;
}

.message small {
  color: #94a3b8;
}

.composer {
  display: flex;
  gap: 12px;
  padding: 18px 28px 26px;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
}

.composer button {
  background: linear-gradient(135deg, #10b981, #06b6d4);
  color: white;
}

.empty-state {
  display: grid;
  place-items: center;
  flex: 1;
  color: #94a3b8;
  font-size: 1.1rem;
}

@media (max-width: 900px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }

  .video-panel {
    grid-template-columns: 1fr;
  }
}
